* {
    /* Map Hellwal colors to Rofi variables */
    bg: #%%color1%%;
    fg: #%%color7%%;
    accent: #%%color14%%;
    muted: #%%color3%%;
    on-accent: #%%color15%%;
    color15: #%%color15%%;
    color1: #%%color1%%;
    color7: #%%color7%%;
    color8: #%%color3%%;

    font: "Zalando Sans Expanded 15";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 35%;
    padding: 16px;
    background-color: @color1;
    border: 2px;
    border-color: @color8; /* Swapped to color8/color3 for the matching theme border */
    border-radius: 6px;
}

listview {
    lines: 3;
    spacing: 6px;
}

element {
    padding: 8px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 6px;
}

/* Selected item gets the dynamic list selection values */
element selected {
    background-color: @color8;
    text-color: @color15;
}

element-text selected {
    text-color: @color15;
}

element-icon {
    size: 0.0ch;
}
